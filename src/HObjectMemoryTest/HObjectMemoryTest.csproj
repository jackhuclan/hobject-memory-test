<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HObjectMemory.Lifetime\HObjectMemory.Lifetime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnetxl">
      <HintPath>..\..\dlls\halcondotnetxl.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 原生 Halcon 运行库不会随托管引用复制，需显式带到输出目录 -->
  <ItemGroup>
    <Content Include="..\..\dlls\halconxl.dll" Link="halconxl.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
